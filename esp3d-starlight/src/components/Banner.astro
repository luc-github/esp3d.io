---
import Default from '@astrojs/starlight/components/Banner.astro';
import AdSense from './AdSense.astro';

const bannerAdSlot = '1983859643';
---

<Default>
  <slot />
</Default>

{
  bannerAdSlot && (
    <div class="top-banner-adsense print:hidden" aria-label="Advertisement">
      <AdSense slot={bannerAdSlot} />
    </div>
  )
}

<style>
  .top-banner-adsense {
    margin: 0 auto 1rem;
    padding: 0 1rem;
    max-width: var(--sl-content-width);
  }
</style>
