---
import Default from '@astrojs/starlight/components/PageTitle.astro';
---

<div class="page-title-with-left-offset">
  <div class="page-title-left-spacer" aria-hidden="true"></div>
  <div class="page-title-main">
    <Default />
  </div>
</div>

<style>
  .page-title-with-left-offset {
    display: block;
  }

  .page-title-left-spacer {
    display: none;
  }

  @media (min-width: 90rem) {
    .page-title-with-left-offset {
      display: grid;
      grid-template-columns: clamp(8.5rem, 11vw, 11.5rem) minmax(0, 1fr);
      gap: 0.75rem;
      align-items: start;
    }

    .page-title-left-spacer {
      display: block;
    }
  }
</style>
