---
import Default from '@astrojs/starlight/components/Footer.astro';
import AdSense from './AdSense.astro';

const footerAdSlot = '5181490744';
---

<Default>
  <slot />
</Default>

{
  footerAdSlot && (
    <div class="footer-adsense-wrap print:hidden" aria-label="Advertisement">
      <AdSense slot={footerAdSlot} />
    </div>
  )
}

<style>
  .footer-adsense-wrap {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
</style>
