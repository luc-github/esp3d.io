---
import Default from '@astrojs/starlight/components/Footer.astro';
import PayPalDonate from './PayPalDonate.astro';
---

<Default>
  <slot />
</Default>

<!-- Ton bouton PayPal en bas du footer -->
<div class="footer-donate">
  <PayPalDonate />
</div>

<style>
  .footer-donate {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-gray-5);
    text-align: center;
  }

  /* Optionnel : sur mobile on peut centrer encore mieux */
  @media (max-width: 50em) {
    .footer-donate {
      margin-top: 2rem;
    }
  }
</style>
