---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import PayPalDonate from './PayPalDonate.astro';
import AdSense from './AdSense.astro';

const navAdSlot = '6407325970';
---

<Default>
  <slot />
</Default>

<!-- Bouton PayPal en bas de la sidebar gauche -->
<div class="sidebar-donate">
  <PayPalDonate />
</div>

<!-- Pub AdSense sous PayPal, visible surtout sur mobile/tablette -->
{navAdSlot && (
  <div class="sidebar-nav-ad">
    <AdSense slot={navAdSlot} format="auto" style="display:block;" />
  </div>
)}

<style>
  .sidebar-donate {
    margin-top: 2rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  /* Style plus joli sur mobile */
  @media (max-width: 50em) {
    .sidebar-donate {
      margin-top: 1.5rem;
      padding: 1rem;
    }
  }

  .sidebar-nav-ad {
    margin-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: 0.75rem;
  }

</style>
