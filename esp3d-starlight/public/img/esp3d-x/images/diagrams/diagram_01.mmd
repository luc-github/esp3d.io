        SETLIST[Settings List]
        CONNSTATUS[Connection Status]
    end

    subgraph Settings List Submenu
        POLLING[Polling]
        TIMEOUT[Time Out]
    end

    subgraph Shared Screens
        MSGBOX[Message Box]
        INPUT[Input Screen]
